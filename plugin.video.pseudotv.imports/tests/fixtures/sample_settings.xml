<?xml version="1.0" ?>
<settings version="1">
    <section id="test.section">
        <category id="general" label="30000" help="33000">
            <group id="1" label="30010">
                <setting id="Enable_Foo" type="boolean" label="30011" help="33011">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="Foo_Limit" type="integer" label="30012" help="33012" parent="Enable_Foo">
                    <level>1</level>
                    <default>5</default>
                    <constraints>
                        <minimum>1</minimum>
                        <step>1</step>
                        <maximum>25</maximum>
                    </constraints>
                    <dependencies>
                        <dependency type="visible">
                            <condition operator="is" setting="Enable_Foo">true</condition>
                        </dependency>
                    </dependencies>
                    <control type="slider" format="integer">
                        <popup>false</popup>
                    </control>
                </setting>
                <setting id="Foo_Mode" type="integer" label="30013" help="33013">
                    <level>2</level>
                    <default>0</default>
                    <constraints>
                        <options>
                            <option label="30014">0</option>
                            <option label="30015">1</option>
                        </options>
                    </constraints>
                    <control type="spinner" format="string"/>
                </setting>
            </group>
            <group id="2" label="30020">
                <setting id="Launch_Foo" type="action" label="30021" help="33021">
                    <level>1</level>
                    <data>RunScript(special://home/addons/test/foo.py, run)</data>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <dependencies>
                        <dependency type="enable">
                            <and>
                                <condition on="property" name="InfoBool">System.HasAddon(test.addon)</condition>
                                <condition on="property" name="InfoBool">System.AddonIsEnabled(test.addon)</condition>
                            </and>
                        </dependency>
                    </dependencies>
                    <control type="button" format="action">
                        <close>true</close>
                    </control>
                </setting>
                <setting id="Foo_Gated" type="string" label="30022" help="33022">
                    <level>2</level>
                    <default>Auto</default>
                    <constraints>
                        <allowempty>false</allowempty>
                    </constraints>
                    <dependencies>
                        <dependency type="visible">
                            <or>
                                <condition operator="is" setting="Enable_Foo">false</condition>
                                <condition operator="gt" setting="Foo_Mode">0</condition>
                            </or>
                        </dependency>
                        <dependency type="enable">
                            <condition operator="!is" setting="Foo_Limit">25</condition>
                        </dependency>
                    </dependencies>
                    <control type="button" format="action">
                        <data>RunScript(special://home/addons/test/foo.py, select)</data>
                    </control>
                </setting>
            </group>
        </category>
        <category id="paths" label="30030" help="">
            <group id="1">
                <setting id="Foo_Folder" type="path" label="30031" help="33031">
                    <level>2</level>
                    <default>special://profile/foo</default>
                    <constraints>
                        <sources>
                            <source>files</source>
                        </sources>
                        <writable>true</writable>
                    </constraints>
                    <control type="button" format="path">
                        <heading>30031</heading>
                    </control>
                </setting>
                <setting id="Foo_Resources" type="list[addon]" label="30032" help="33032">
                    <level>2</level>
                    <default>res.one|res.two</default>
                    <constraints>
                        <addontype>kodi.resource.images</addontype>
                    </constraints>
                    <control type="button" format="addon">
                        <heading>30032</heading>
                        <show more="true" details="true">installed</show>
                        <multiselect>true</multiselect>
                    </control>
                </setting>
            </group>
        </category>
    </section>
</settings>
